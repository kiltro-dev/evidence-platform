# Copy to .env. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
# Optional: override the SQLite path (default: ./data/atlas.db)
# ATLAS_DB=./data/atlas.db
# Optional: disable the live-web counter-evidence pass (default: on)
# ATLAS_WEB_FALSIFY=0
# Optional: OpenAlex API key (free; own $1/day quota instead of shared
# $0.10/day IP budget — set before demos on shared networks)
# OPENALEX_API_KEY=
