# Copy to .env. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
# Optional: override the SQLite path (default: ./data/atlas.db)
# ATLAS_DB=./data/atlas.db
# Optional: disable the live-web counter-evidence pass (default: on)
# ATLAS_WEB_FALSIFY=0
# Optional: OpenAlex API key (free; own $1/day quota instead of shared
# $0.10/day IP budget — set before demos on shared networks)
# OPENALEX_API_KEY=
# Optional: real contact email for the OpenAlex polite pool (no
# placeholder default is shipped; when unset the parameter is omitted)
# OPENALEX_MAILTO=you@example.com
# Optional: public-deploy auth — when set, X-API-Key is required on
# analyze/check/reports (status + UI stay open); see docs/SECURITY_OPS.md
# ATLAS_API_KEY=
# Optional: allow non-loopback clients WITHOUT a key (NOT for public
# deploys — the loopback guard is the only boundary then)
# ATLAS_ALLOW_NON_LOOPBACK=1
# Optional: trust X-Forwarded-For for rate buckets — ONLY behind a proxy
# that overwrites XFF (never trust client-supplied XFF directly)
# ATLAS_TRUST_PROXY=1
# Optional: CORS allowlist for browser sidecars (comma-separated, no
# credentials; empty = same-origin only)
# ATLAS_CORS_ORIGINS=https://app.example.com
# Optional: disable the claimed-precision rule (default: on)
# ATLAS_PRECISION_RULE=0
